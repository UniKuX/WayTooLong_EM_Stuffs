Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update && apt-get install -y \
        wget \
        ca-certificates \
        openjdk-8-jdk \
        libglu1-mesa \
        libgl1-mesa-glx \
        libsm6 \
        libice6 \
        libx11-6 \
        libxext6 \
        libxrender1 \
        libxrandr2 \
        libxi6 \
        libxcb1 \
        libxkbcommon0 \
        libx11-xcb1 \
        libfontconfig1 \
        libfreetype6 \
        libxv1 \
        libxxf86vm1 \
        libxcursor1 \
        libxinerama1 \
        mesa-utils \
        x11-apps \
        sudo

    cd /tmp
    wget --no-check-certificate https://bio3d.colorado.edu/imod/AMD64-RHEL5/imod_5.1.9_RHEL8-64_CUDA12.0.sh
    chmod +x imod_5.1.9_RHEL8-64_CUDA12.0.sh
    ./imod_5.1.9_RHEL8-64_CUDA12.0.sh 
    rm imod_5.1.9_RHEL8-64_CUDA12.0.sh

%environment
    export PATH=/usr/local/imod_5.1.9/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/imod_5.1.9/lib:$LD_LIBRARY_PATH
    export QT_QPA_PLATFORM=xcb
    export DISPLAY=${DISPLAY}
    export XAUTHORITY=${XAUTHORITY:-/root/.Xauthority}
    export LIBGL_ALWAYS_INDIRECT=1